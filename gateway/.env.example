# YOUPI PG — cPanel gateway — PLACEHOLDERS ONLY
# Copy this file to gateway/.env for local development only.
# On Hostinger / cPanel, set these same variables in the Node.js App panel
# instead of uploading a .env file, and keep the app folder OUTSIDE public_html.
# NEVER commit a real .env file. NEVER put a real secret in this file.
# The installer wizard (/install) can also create gateway/.env for you on
# first setup, with freshly generated secrets, and then locks itself.

# App
NODE_ENV=development
# cPanel assigns the port; the app MUST listen on process.env.PORT.
# PORT is set by the host. Leave it unset locally to use 3000.
# PORT=3000
APP_BASE_URL=https://example.com
APP_NAME=YOUPI PG

# MySQL (cPanel MySQL database, user and password created in cPanel first)
DB_HOST=localhost
DB_PORT=3306
DB_USER=example_dbuser
DB_PASSWORD=change-me-db-password
DB_NAME=example_dbname
DB_CONNECTION_LIMIT=5

# Secrets — generate fresh values, never reuse the placeholders below.
# SESSION_SECRET: at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-session-secret-at-least-32-chars
# ENCRYPTION_MASTER_KEY: exactly 64 hex characters (32 random bytes).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=REPLACE_WITH_64_HEX_CHARS_GENERATED_BY_crypto_randomBytes_32

# Verification mode. Allowed: manual, observer, provider.
# Default is manual reconciliation. Do NOT set this to provider unless a
# real provider integration is configured and tested (see docs/API.md).
VERIFICATION_MODE=manual

# Optional — external observer ingestion. Leave unset to disable it.
# If set, observers must send this token as X-Observer-Token, and events
# are still validated (merchant, amount, fingerprint, order status) before
# any order can succeed.
# OBSERVER_API_TOKEN=change-me-observer-token

# Optional — provider webhook. Leave unset to disable provider mode.
# If set, provider webhooks must be HMAC-signed with this secret.
# A provider integration is NOT included by default; it requires a real
# provider contract, credentials and testing (see docs/API.md).
# PROVIDER_WEBHOOK_SECRET=change-me-provider-secret

# Optional — cron protection. If set, POST /cron/webhooks and
# POST /cron/expire require header X-Cron-Secret with this value.
# If unset, cron endpoints return 503 (disabled) in production.
# CRON_SECRET=change-me-cron-secret

# Optional — email delivery (SMTP) for password-reset and email-verification
# emails. Leave all four unset to disable email delivery; the app then
# shows a clear "email not configured" notice instead of pretending an
# email was sent. Never put a real SMTP password in this example file.
# SMTP_HOST=<redacted>
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<redacted>
# SMTP_PASS=<redacted>
# SMTP_FROM=<redacted>
